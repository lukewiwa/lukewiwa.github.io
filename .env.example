# Django Core Settings (REQUIRED)
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DOMAIN=localhost

# Initial Superuser (REQUIRED for first setup)
INITIAL_SUPERUSER_USERNAME=admin
INITIAL_SUPERUSER_PASSWORD=changeme
INITIAL_SUPERUSER_EMAIL=admin@example.com

# Database
# SQLite on local disk. In production Litestream replicates this to S3 and
# restores it when a new Lambda execution environment starts.
DB_PATH=/tmp/db.sqlite3

# Litestream
# Leave LITESTREAM_REPLICA_URL empty to run with a purely local database.
LITESTREAM_CONFIG=/function/litestream.yml
# The daemon control socket that `litestream sync` connects to.
LITESTREAM_SOCKET=/tmp/litestream.sock
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=localdev
LITESTREAM_SECRET_ACCESS_KEY=localdevsecret
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_FORCE_PATH_STYLE=true

# Media storage: "filesystem" or "s3"
MEDIA_BACKEND=filesystem
AWS_STORAGE_BUCKET_NAME=wiwablog
AWS_S3_ACCESS_KEY_ID=localdev
AWS_S3_SECRET_ACCESS_KEY=localdevsecret
AWS_S3_ENDPOINT_URL=http://localhost:9000

# Publishing
# PUBLISH_TARGET is "filesystem" (a local directory) or "s3" (any S3 API,
# which means RustFS locally and the real thing in production).
PUBLISH_TARGET=filesystem
PUBLISH_DESTINATION=
BUILD_DIR=/tmp/build
PUBLISH_RUNNER=inline
PUBLISH_BUCKET_NAME=wiwa-site
PUBLISH_ENDPOINT_URL=http://localhost:9000
PUBLISH_ACCESS_KEY_ID=localdev
PUBLISH_SECRET_ACCESS_KEY=localdevsecret
# Set only in production; without it a publish skips cache invalidation.
CLOUDFRONT_DISTRIBUTION_ID=
